# MythForge backend configuration. Copy to .env and fill in.
DATABASE_URL=postgres://forge:forge@127.0.0.1:55440/forge
ADMIN_DATABASE_URL=postgres://forge:forge@127.0.0.1:55440/postgres
PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5173

# Anthropic-compatible endpoint + model (z.ai GLM works with the Messages API).
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=glm-5.3-flash
ANTHROPIC_MAX_TOKENS=4096

# Google OAuth2 (Calendar + Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RUST_LOG=info,sqlx=warn
