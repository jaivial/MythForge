# Runtime configuration for the MythForge docker compose stack.
# Copy to .env and fill in real values; never commit real secrets.
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=glm-5.3-flash
ANTHROPIC_MAX_TOKENS=8192
JWT_SECRET=replace-me-with-32-plus-random-chars
APP_URL=https://forge.myth.services
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
CORS_ORIGINS=https://forge.myth.services
